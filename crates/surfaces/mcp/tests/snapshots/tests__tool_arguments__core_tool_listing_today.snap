  {
    "name": "specforge.render",
    "description": "Render output in a specified format",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "description": "Renderer to use: graph (also json): every entity with its fields, file and line (Graph Protocol); context: headline and normative fields and verify, for an agent; brief: id, kind and title; dot: Graphviz; markdown: a document a reviewer reads: each entity's statements, fields, links and obligations",
          "enum": [
            "graph",
            "context",
            "brief",
            "dot",
            "markdown",
            "json"
          ],
          "type": "string"
        },
        "out_dir": {
          "description": "Directory to write the rendering into, inside the project (relative to its root; returned inline when omitted)",
          "type": "string"
        },
        "scope": {
          "description": "Scope to entity",
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "enum": [
            "graph",
            "context",
            "brief",
            "dot",
            "markdown"
          ],
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "output_files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "output_files"
      ],
      "type": "object"
    },
    "category": "management",
    "source": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
