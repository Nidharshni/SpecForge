            "end_line",
            "end_col"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "report": {
          "type": "string"
        },
        "runners": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "by_convention": {
                "minimum": 0,
                "type": "integer"
              },
              "entities": {
                "minimum": 0,
                "type": "integer"
              },
              "exit_code": {
                "type": "integer"
              },
              "extension": {
                "type": "string"
              },
              "failed": {
                "minimum": 0,
                "type": "integer"
              },
              "files": {
                "minimum": 0,
                "type": "integer"
              },
              "name": {
                "type": "string"
              },
              "passed": {
                "minimum": 0,
                "type": "integer"
              },
              "ran": {
                "type": "boolean"
              },
              "skipped": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "name",
              "extension",
              "ran",
              "files",
              "by_convention",
              "entities",
              "passed",
              "failed",
              "skipped"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "status": {
          "enum": [
            "collected"
          ],
          "type": "string"
        }
      },
      "required": [
        "status",
        "runners",
        "diagnostics",
        "report"
      ],
      "type": "object"
    },
    "category": "management",
    "source": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true
    }
