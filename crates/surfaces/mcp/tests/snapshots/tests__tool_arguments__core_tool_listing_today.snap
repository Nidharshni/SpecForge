  {
    "name": "specforge.migrate",
    "description": "Run migration pipeline",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Return the diffs without changing any file",
          "type": "boolean"
        },
        "no_backup": {
          "default": false,
          "description": "Skip the .bak backup of each migrated file",
          "type": "boolean"
        },
        "path": {
          "description": "Project root path (the served project if omitted)",
          "type": "string"
        },
        "target_version": {
          "description": "Format version to migrate to, as MAJOR.MINOR (defaults to the current format version)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Diagnostic": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "column": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "data": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "did_you_mean": {
                      "type": "string"
                    },
                    "entity": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "unresolved_reference"
                      ],
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "target",
                    "entity",
                    "field"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "did_you_mean": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "unresolved_import"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "keyword": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "shadowed_keyword"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "keyword"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "reference_cycle"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "subject"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "entity"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "failures": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "entity": {
                            "type": "string"
                          },
                          "error": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "entity",
                          "error"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "function": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "custom_rule_failures"
                      ],
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "rule",
                    "function",
                    "failures"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "Error",
                "Warning",
                "Info"
              ],
              "type": "string"
            },
            "span": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceSpan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "suggestion": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "title",
            "severity",
            "message",
            "span",
            "suggestion",
            "file",
            "line",
            "column"
          ],
          "type": "object"
        },
        "FormatVersion": {
          "additionalProperties": false,
          "properties": {
            "major": {
              "minimum": 0,
              "type": "integer"
            },
            "minor": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "major",
            "minor"
          ],
          "type": "object"
        },
        "MigrationDiff": {
          "additionalProperties": false,
          "properties": {
            "after_hash": {
              "type": "string"
            },
            "before_hash": {
              "type": "string"
            },
            "file_path": {
              "type": "string"
            },
            "unified_text": {
              "type": "string"
            }
          },
          "required": [
            "file_path",
            "before_hash",
            "after_hash",
            "unified_text"
          ],
          "type": "object"
        },
        "MigrationResult": {
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "string"
            },
            "file_path": {
              "type": "string"
            },
            "from_version": {
              "$ref": "#/$defs/FormatVersion"
            },
            "status": {
              "enum": [
                "migrated",
                "skipped",
                "failed",
                "restored"
              ],
              "type": "string"
            },
            "to_version": {
              "$ref": "#/$defs/FormatVersion"
            }
          },
          "required": [
            "file_path",
            "status"
          ],
          "type": "object"
        },
        "SourceSpan": {
          "additionalProperties": false,
          "properties": {
            "end_col": {
              "minimum": 0,
              "type": "integer"
            },
            "end_line": {
              "minimum": 0,
              "type": "integer"
            },
            "file": {
              "type": "string"
            },
            "start_col": {
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "file",
            "start_line",
            "start_col",
            "end_line",
            "end_col"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "backups": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "backup_path": {
                "type": "string"
              },
              "original_path": {
                "type": "string"
              }
            },
            "required": [
              "original_path",
              "backup_path"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "diagnostics": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "diffs": {
          "items": {
            "$ref": "#/$defs/MigrationDiff"
          },
          "type": "array"
        },
        "dry_run": {
          "type": "boolean"
        },
        "files_failed": {
          "minimum": 0,
          "type": "integer"
        },
        "files_migrated": {
          "minimum": 0,
          "type": "integer"
        },
        "files_skipped": {
          "minimum": 0,
          "type": "integer"
        },
        "files_written": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from_version": {
          "type": "string"
        },
        "hook_failures": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hooks_invoked": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "migrated": {
          "type": "boolean"
        },
        "ok": {
          "type": "boolean"
        },
        "pending": {
          "type": "boolean"
        },
        "post_migration_errors": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "post_migration_validated": {
          "type": "boolean"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/MigrationResult"
          },
          "type": "array"
        },
        "structural_differences": {
          "items": {
            "$ref": "#/$defs/Diagnostic"
          },
          "type": "array"
        },
        "to_version": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "pending",
        "from_version",
        "to_version",
        "diagnostics",
        "migrated",
        "dry_run",
        "files_migrated",
        "files_skipped",
        "files_failed",
        "results",
        "diffs",
        "backups",
        "hooks_invoked",
        "hook_failures",
        "structural_differences",
        "post_migration_validated",
        "post_migration_errors"
      ],
      "type": "object"
    },
    "category": "mutation",
    "source": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false
    }
