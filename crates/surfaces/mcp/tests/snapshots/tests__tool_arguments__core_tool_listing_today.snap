    "source": "core",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "specforge.trace",
    "description": "Show traceability chain for an entity, or check an agent plan for gaps (entity_id or plan)",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "description": "Entity ID to trace",
          "type": "string"
        },
        "plan": {
          "additionalProperties": false,
          "description": "An AgentPlan ({\"plan_id\", \"entries\": [{\"entity_id\", \"action\"}]}), or its JSON text, to check for gaps against the graph instead of tracing one entity; not with entity_id",
          "properties": {
            "entries": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "action": {
                    "type": "string"
                  },
                  "entity_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "entity_id",
                  "action"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "plan_id": {
              "type": "string"
            }
          },
          "required": [
            "plan_id",
            "entries"
          ],
          "type": "object"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "TraceLink": {
          "additionalProperties": false,
          "properties": {
            "depth": {
              "minimum": 0,
              "type": "integer"
            },
            "edge_label": {
              "type": "string"
            },
            "entity_id": {
              "type": "string"
            },
            "entity_kind": {
              "type": "string"
            },
            "status": {
              "enum": [
                "resolved",
                "missing"
              ],
              "type": "string"
            }
          },
          "required": [
            "entity_id",
            "entity_kind",
            "edge_label",
            "depth",
            "status"
          ],
          "type": "object"
        }
      },
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "downstream": {
              "items": {
                "$ref": "#/$defs/TraceLink"
              },
              "type": "array"
            },
            "entity_id": {
              "type": "string"
            },
            "entity_kind": {
              "type": "string"
            },
            "missing": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "depth": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "edge_label": {
                    "type": "string"
                  },
                  "edge_type": {
                    "type": "string"
                  },
                  "expected_kind": {
                    "type": "string"
                  },
                  "from": {
                    "type": "string"
                  },
                  "from_kind": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  },
                  "status": {
                    "enum": [
                      "resolved",
                      "missing"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "from",
                  "from_kind",
                  "edge_label",
                  "expected_kind",
                  "depth",
                  "required",
                  "status"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "schema_version": {
              "type": "string"
            },
            "upstream": {
              "items": {
                "$ref": "#/$defs/TraceLink"
              },
              "type": "array"
            }
          },
          "required": [
            "schema_version",
            "entity_id",
            "entity_kind",
            "upstream",
            "downstream",
            "missing"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
