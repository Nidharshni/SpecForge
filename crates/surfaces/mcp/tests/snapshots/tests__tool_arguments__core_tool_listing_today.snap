  {
    "name": "specforge.collect",
    "description": "Record which entities the project's tests prove, from the test runner's report (runs the runner only with run: true and prior approval)",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "description": "Project root path (the served project if omitted)",
          "type": "string"
        },
        "run": {
          "default": false,
          "description": "Run the test command first; it must have been approved with `specforge collect` in a terminal (otherwise the existing report is parsed)",
          "type": "boolean"
        },
        "runner": {
          "description": "Collector name (e.g. cargo-test); detected from project files if omitted",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Diagnostic": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "column": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "data": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "did_you_mean": {
                      "type": "string"
                    },
                    "entity": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "unresolved_reference"
                      ],
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "target",
                    "entity",
                    "field"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "did_you_mean": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "unresolved_import"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "keyword": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "shadowed_keyword"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "keyword"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "reference_cycle"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "subject"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "entity"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "failures": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "entity": {
                            "type": "string"
                          },
                          "error": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "entity",
                          "error"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "function": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "custom_rule_failures"
                      ],
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "rule",
                    "function",
                    "failures"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "Error",
                "Warning",
                "Info"
              ],
              "type": "string"
            },
            "span": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceSpan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "suggestion": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "title",
            "severity",
            "message",
            "span",
            "suggestion",
            "file",
            "line",
            "column"
          ],
          "type": "object"
        },
        "SourceSpan": {
          "additionalProperties": false,
          "properties": {
            "end_col": {
              "minimum": 0,
              "type": "integer"
            },
            "end_line": {
              "minimum": 0,
              "type": "integer"
            },
