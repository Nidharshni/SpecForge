---
source: crates/surfaces/mcp/tests/tool_arguments.rs
expression: listing
---
[
  {
    "name": "specforge.query",
    "description": "Query the graph at multiple resolutions",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "default": 1,
          "description": "Number of hops",
          "minimum": 0,
          "type": "integer"
        },
        "entity_id": {
          "description": "Entity ID to query",
          "type": "string"
        },
        "format": {
          "default": "graph",
          "description": "Output detail level: graph (also json): every entity with its fields, file and line (Graph Protocol); context: headline and normative fields and verify, for an agent; brief: id, kind and title",
          "enum": [
            "graph",
            "context",
            "brief",
            "json"
          ],
          "type": "string"
        },
        "include_coverage": {
          "default": false,
          "description": "Include coverage metadata in the response",
          "type": "boolean"
        },
        "kinds": {
          "description": "Filter by entity kinds",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "entity_id"
      ],
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Edge": {
          "additionalProperties": false,
          "properties": {
            "label": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "required": [
            "source",
            "target",
            "label"
          ],
          "type": "object"
        },
        "FieldJson": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/FieldJson"
              },
              "type": "object"
            }
          ]
        },
        "GraphProtocolSchema": {
          "additionalProperties": false,
          "properties": {
            "edge_types": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "source_extension": {
                    "type": "string"
                  },
                  "source_kinds": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "target_kinds": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "label",
                  "source_extension"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "entity_kinds": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "dot_color": {
                    "type": "string"
                  },
                  "fields": {
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "default_value": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "edge": {
                          "type": "string"
                        },
                        "enum_values": {
                          "items": {
                            "type": "string"
                          },
                          "type": "array"
                        },
                        "field_type": {
                          "enum": [
                            "string",
                            "integer",
                            "bool",
                            "enum",
                            "identifier",
                            "string_list",
                            "reference",
                            "reference_list",
                            "block"
                          ],
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        },
                        "required": {
                          "type": "boolean"
                        },
                        "source_extension": {
                          "type": "string"
                        },
                        "target_kind": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "name",
                        "field_type",
                        "required",
                        "source_extension"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "name": {
                    "type": "string"
                  },
                  "source_extension": {
                    "type": "string"
                  },
                  "testable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "source_extension",
                  "testable",
                  "fields"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "extensions": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "schema_version": {
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "major": {
                  "minimum": 0,
                  "type": "integer"
                },
                "minor": {
                  "minimum": 0,
                  "type": "integer"
                },
                "patch": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "major",
                "minor",
                "patch"
              ],
              "type": "object"
            }
          },
          "required": [
            "schema_version",
            "extensions",
            "entity_kinds",
            "edge_types"
          ],
          "type": "object"
        },
        "SchemaRefBlock": {
          "additionalProperties": false,
          "properties": {
            "content_hash": {
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "content_hash"
          ],
          "type": "object"
        },
        "TokenBudget": {
          "additionalProperties": false,
          "properties": {
            "budget_tokens": {
              "minimum": 0,
              "type": "integer"
            },
            "estimated_tokens": {
              "minimum": 0,
              "type": "integer"
            },
            "strategy": {
              "type": "string"
            },
            "truncated_entities": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "strategy",
            "budget_tokens",
            "estimated_tokens",
            "truncated_entities"
          ],
          "type": "object"
        },
        "VerifyStatement": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "description"
          ],
          "type": "object"
        }
      },
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "edges": {
              "items": {
                "$ref": "#/$defs/Edge"
              },
              "type": "array"
            },
            "format_version": {
              "enum": [
                "1.0",
                "2.0"
              ],
              "type": "string"
            },
            "nodes": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "coverage_status": {
                    "enum": [
                      "covered",
                      "partial",
                      "uncovered",
                      "exempt",
                      "not_testable"
                    ],
                    "type": "string"
                  },
                  "fields": {
                    "additionalProperties": {
                      "$ref": "#/$defs/FieldJson"
                    },
                    "type": "object"
                  },
                  "file": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "line": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  },
                  "verify": {
                    "items": {
                      "$ref": "#/$defs/VerifyStatement"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "file",
                  "line",
                  "fields"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "schema": {
              "$ref": "#/$defs/GraphProtocolSchema"
            },
            "schema_ref": {
              "$ref": "#/$defs/SchemaRefBlock"
            },
            "schema_version": {
              "type": "string"
            },
            "token_budget": {
              "$ref": "#/$defs/TokenBudget"
            }
          },
          "required": [
            "schema_version",
            "nodes",
            "edges"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edges": {
              "items": {
                "$ref": "#/$defs/Edge"
              },
              "type": "array"
            },
            "format_version": {
              "enum": [
                "1.0",
                "2.0"
              ],
              "type": "string"
            },
            "nodes": {
              "items": {
                "additionalProperties": {
                  "type": "string"
                },
                "properties": {
                  "coverage_status": {
                    "enum": [
                      "covered",
                      "partial",
                      "uncovered",
                      "exempt",
                      "not_testable"
                    ],
                    "type": "string"
                  },
                  "fields": {
                    "additionalProperties": {
                      "$ref": "#/$defs/FieldJson"
                    },
                    "type": "object"
                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "verify": {
                    "items": {
                      "$ref": "#/$defs/VerifyStatement"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "schema": {
              "$ref": "#/$defs/GraphProtocolSchema"
            },
            "schema_ref": {
              "$ref": "#/$defs/SchemaRefBlock"
            },
            "schema_version": {
              "type": "string"
            },
            "token_budget": {
              "$ref": "#/$defs/TokenBudget"
            }
          },
          "required": [
            "schema_version",
            "nodes",
            "edges"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "edges": {
              "items": {
                "$ref": "#/$defs/Edge"
              },
              "type": "array"
            },
            "format_version": {
              "enum": [
                "1.0",
                "2.0"
              ],
              "type": "string"
            },
            "nodes": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "coverage_status": {
                    "enum": [
                      "covered",
                      "partial",
                      "uncovered",
                      "exempt",
                      "not_testable"
                    ],
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "schema": {
              "$ref": "#/$defs/GraphProtocolSchema"
            },
            "schema_ref": {
              "$ref": "#/$defs/SchemaRefBlock"
            },
            "schema_version": {
              "type": "string"
            },
            "token_budget": {
              "$ref": "#/$defs/TokenBudget"
            }
          },
          "required": [
            "schema_version",
            "nodes",
