  {
    "name": "specforge.infer_session",
    "description": "Manage inference sessions: start a new session, mark files as analyzed, or end a session",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "description": "Session action to perform: start: begin a session; one may be active at a time; mark_analyzed: record a source file and the entities inferred from it; end: end the active session",
          "enum": [
            "start",
            "mark_analyzed",
            "end"
          ],
          "type": "string"
        },
        "agent": {
          "description": "Agent identifier (for start)",
          "type": "string"
        },
        "entities_produced": {
          "description": "Entity IDs produced from the file (for mark_analyzed)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session_id": {
          "description": "Session ID to end (for end)",
          "type": "string"
        },
        "source_file": {
          "description": "Relative path to analyzed file (for mark_analyzed)",
          "type": "string"
        },
        "source_roots": {
          "description": "Source directories to scan (for start)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "default": "completed",
          "description": "Final status (for end): completed: the inference is done; paused: a later session continues it",
          "enum": [
            "completed",
            "paused"
          ],
          "type": "string"
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "entities_produced": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "files_written": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session_id": {
          "type": "string"
        },
        "source_file": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "category": "mutation",
    "source": "core",
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
