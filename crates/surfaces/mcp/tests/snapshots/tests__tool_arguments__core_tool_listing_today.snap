  {
    "name": "specforge.validate",
    "description": "Recompile and validate the spec project",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "lint": {
          "description": "Extra lint profiles, as `specforge check --lint` takes (inferred: I200/I202 from specforge-infer.json; pedantic is the default and adds nothing)",
          "items": {
            "enum": [
              "inferred",
              "pedantic"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "description": "Project root path (the served project if omitted)",
          "type": "string"
        },
        "severity_filter": {
          "description": "Only report diagnostics of this severity, after strict promotion (case-insensitive). The verdict in _meta[\"specforge/check\"] still counts everything reported",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Promote warnings to errors, before severity_filter applies",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "specforge.analyze",
    "description": "Run analysis passes (coverage: proof obligations and discharge funnel; contracts: clause symmetry) over the compiled project",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "description": "Proof-coverage minimum, in percent (0 to 100): below it the run fails (E048); it needs test results and the coverage pass",
          "type": "number"
        },
        "pass": {
          "default": "all",
          "description": "Analysis pass to run: all, coverage, contracts, or a pass an extension declares (`<extension>:<pass>`)",
          "type": "string"
        },
        "path": {
          "description": "Project root path (the served project if omitted)",
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Promote warnings to errors",
          "type": "boolean"
        },
        "test_results": {
          "description": "Path to a specforge-report.json for proof-level verdicts",
          "type": "string"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "$defs": {
        "Diagnostic": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "column": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "data": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "did_you_mean": {
                      "type": "string"
                    },
                    "entity": {
                      "type": "string"
                    },
                    "field": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "unresolved_reference"
                      ],
                      "type": "string"
                    },
                    "target": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "target",
                    "entity",
                    "field"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "did_you_mean": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "unresolved_import"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "keyword": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "shadowed_keyword"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "keyword"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "enum": [
                        "reference_cycle"
                      ],
                      "type": "string"
                    },
                    "path": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "required": [
                    "kind",
                    "path"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "subject"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "entity"
                  ],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "failures": {
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "entity": {
                            "type": "string"
                          },
                          "error": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "entity",
                          "error"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "function": {
                      "type": "string"
                    },
                    "kind": {
                      "enum": [
                        "custom_rule_failures"
                      ],
                      "type": "string"
                    },
                    "rule": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "rule",
                    "function",
                    "failures"
                  ],
                  "type": "object"
                }
              ],
              "type": "object"
            },
            "file": {
              "type": [
                "string",
                "null"
              ]
            },
            "line": {
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "severity": {
              "enum": [
                "Error",
                "Warning",
                "Info"
              ],
              "type": "string"
            },
            "span": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceSpan"
                },
                {
                  "type": "null"
                }
              ]
            },
            "suggestion": {
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "code",
            "title",
            "severity",
            "message",
            "span",
            "suggestion",
            "file",
            "line",
            "column"
          ],
          "type": "object"
        },
        "SourceSpan": {
          "additionalProperties": false,
          "properties": {
            "end_col": {
              "minimum": 0,
              "type": "integer"
            },
            "end_line": {
              "minimum": 0,
              "type": "integer"
            },
            "file": {
              "type": "string"
            },
            "start_col": {
              "minimum": 0,
              "type": "integer"
            },
            "start_line": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "file",
            "start_line",
            "start_col",
            "end_line",
            "end_col"
          ],
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "gate": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "pct": {
                  "type": "number"
                },
                "proven": {
                  "minimum": 0,
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "met"
                  ],
                  "type": "string"
                },
                "total": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "min",
                "pct",
                "proven",
                "total"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "pct": {
                  "type": "number"
                },
                "proven": {
                  "minimum": 0,
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "below"
                  ],
                  "type": "string"
                },
                "total": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "min",
                "pct",
                "proven",
                "total"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "reason": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "unjudged"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "min",
                "reason"
              ],
              "type": "object"
            }
          ],
          "type": "object"
        },
        "ok": {
          "type": "boolean"
        },
        "passes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "findings": {
                "items": {
                  "$ref": "#/$defs/Diagnostic"
                },
                "type": "array"
              },
              "pass": {
                "type": "string"
              },
              "summary": {}
            },
            "required": [
              "pass",
              "findings",
              "summary"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "stray_records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "entity_id": {
                "type": "string"
              },
              "near": {
                "type": "string"
              }
            },
            "required": [
              "entity_id"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "passes"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "specforge.export",
    "description": "Export the graph in various formats",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "description": "With scope, how many hops from the scoped entity to include",
          "minimum": 0,
          "type": "integer"
        },
        "format": {
          "default": "graph",
          "description": "Export format: graph (also json): every entity with its fields, file and line (Graph Protocol); context: headline and normative fields and verify, for an agent; brief: id, kind and title; dot: Graphviz; markdown: a document a reviewer reads: each entity's statements, fields, links and obligations",
          "enum": [
            "graph",
            "context",
            "brief",
            "dot",
            "markdown",
            "json"
          ],
          "type": "string"
        },
        "kinds": {
          "description": "Keep only entities of these kinds; the scoped entity always stays",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_tokens": {
          "description": "Optional token budget; truncates the export to the most central entities that fit",
          "minimum": 0,
          "type": "integer"
        },
        "no_schema": {
          "default": false,
          "description": "Leave the schema out of a graph export (Graph Protocol 1.0)",
          "type": "boolean"
        },
        "schema_version": {
          "description": "Fail unless a reader of this schema version reads the export: the same major version, not newer than the project's schema",
          "type": "string"
        },
        "scope": {
