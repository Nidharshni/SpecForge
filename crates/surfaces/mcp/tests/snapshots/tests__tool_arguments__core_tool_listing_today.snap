  {
    "name": "specforge.init",
    "description": "Initialize a new SpecForge project",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "extensions": {
          "description": "Builtin extensions to enable (e.g. @specforge/software) and local .wasm files to install",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Project name (defaults to the directory name)",
          "type": "string"
        },
        "path": {
          "description": "Directory for the new project, outside the current one",
          "type": "string"
        },
        "version": {
          "default": "0.1.0",
          "description": "Project version",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "config_file": {
          "type": "string"
        },
