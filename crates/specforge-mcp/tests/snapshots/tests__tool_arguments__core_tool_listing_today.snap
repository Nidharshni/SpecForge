  {
    "name": "specforge.render",
    "description": "Render output in a specified format",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "description": "Renderer to use: graph (also json): every entity with its fields, file and line (Graph Protocol); context: headline and normative fields and verify, for an agent; brief: id, kind and title; dot: Graphviz",
          "enum": [
            "graph",
            "context",
            "brief",
            "dot",
            "json"
          ],
          "type": "string"
        },
        "out_dir": {
          "description": "Directory to write the rendering into, relative to the project root (returned inline when omitted)",
          "type": "string"
        },
        "scope": {
          "description": "Scope to entity",
          "type": "string"
        }
      },
      "required": [
        "format"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
