    "name": "specforge.remove_extension",
    "description": "Remove an installed extension",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "description": "Preview the removal, stranded entities included, without changing any file",
          "type": "boolean"
        },
        "force": {
          "default": false,
          "description": "Force removal",
          "type": "boolean"
        },
        "name": {
          "description": "Extension name",
          "type": "string"
        },
        "path": {
          "description": "Project root path (uses initialized root if omitted)",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "files_written": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removed_extension": {
          "type": "string"
        },
        "stranded": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "entity_id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              }
            },
            "required": [
              "entity_id",
              "kind"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "removed_extension",
        "stranded"
      ],
      "type": "object"
    },
    "category": "mutation",
    "source": "core",
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    }
  },
