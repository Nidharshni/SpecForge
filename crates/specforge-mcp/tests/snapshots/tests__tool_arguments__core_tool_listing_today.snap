  {
    "name": "specforge.model",
    "description": "Render the logical data model (entity kinds, fields, relationships)",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "depth": {
          "description": "Maximum depth from root kind (requires root)",
          "minimum": 0,
          "type": "integer"
        },
        "extension": {
          "description": "Filter to a single extension",
          "type": "string"
        },
        "fields": {
          "default": "keys",
          "description": "Field detail level: none; keys: key fields; all",
          "enum": [
            "none",
            "keys",
            "all"
          ],
          "type": "string"
        },
        "format": {
          "default": "markdown",
          "description": "Output format: markdown; mermaid: ER diagram; dot: Graphviz; json; dbml: dbdiagram.io",
          "enum": [
            "markdown",
            "mermaid",
            "dot",
            "json",
            "dbml"
          ],
          "type": "string"
        },
        "group_by": {
          "default": "extension",
          "description": "How to group entities: extension: under a header per extension; none: one flat list",
          "enum": [
            "extension",
            "none"
          ],
          "type": "string"
        },
        "kinds": {
          "description": "Filter to specific entity kinds (empty: every kind)",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "root": {
          "description": "Root entity kind for depth-scoped output",
          "type": "string"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.outline_extensions",
    "description": "Renders the extension architecture hierarchy — how extensions relate via dependencies, enhancements, and cross-extension edges. Shows entity kinds, edge types, validation rules, and surface contributions per extension. Use this to understand the project's extension topology before making structural changes.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "deps": {
          "default": "direct",
          "description": "Dependency visibility: direct: declared only; effective: direct and used transitive; full: all transitive",
          "enum": [
            "direct",
            "effective",
            "full"
          ],
          "type": "string"
        },
        "fields": {
          "default": "keys",
          "description": "Detail level: none: counts only; keys: names and rule codes; all: full field attribution",
          "enum": [
            "none",
            "keys",
            "all"
          ],
          "type": "string"
        },
        "format": {
          "default": "markdown",
          "description": "Output format; json is meant for programs: markdown; mermaid: flowchart; dot: Graphviz; json",
          "enum": [
            "markdown",
            "mermaid",
            "dot",
            "json"
          ],
          "type": "string"
