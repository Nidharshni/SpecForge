            "graph",
            "context",
            "brief",
            "dot"
          ],
          "type": "string"
        },
        "output": {
          "type": "string"
        },
        "output_files": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "output_files"
      ],
      "type": "object"
