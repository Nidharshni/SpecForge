              "kind",
              "file_path",
              "line",
              "score"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "results"
      ],
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
