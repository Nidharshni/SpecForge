  {
    "name": "specforge.validate",
    "description": "Recompile and validate the spec project",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "lint": {
          "description": "Extra lint profiles, as `specforge check --lint` takes (inferred: I200/I202 from specforge-infer.json; pedantic is the default and adds nothing)",
          "items": {
            "enum": [
              "inferred",
              "pedantic"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "path": {
          "description": "Project root path (uses initialized root if omitted)",
          "type": "string"
        },
        "severity_filter": {
          "description": "Only report diagnostics of this severity, after strict promotion (case-insensitive). The verdict in _meta[\"specforge/check\"] still counts everything reported",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Promote warnings to errors, before severity_filter applies",
          "type": "boolean"
        },
        "use_cached": {
          "default": false,
          "description": "Use the last compile instead of bringing the project up to date with disk; with no project served, the path is compiled anyway",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "category": "core",
    "source": "core",
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    }
  },
  {
    "name": "specforge.analyze",
    "description": "Run analysis passes (coverage: proof obligations and discharge funnel; contracts: clause symmetry) over the compiled project",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "min": {
          "description": "Proof-coverage minimum, in percent (0 to 100): below it the run fails (E048); it needs test results and the coverage pass",
          "type": "number"
        },
        "pass": {
          "default": "all",
          "description": "Analysis pass to run: all, coverage, contracts, or a pass an extension declares (`<extension>:<pass>`)",
          "type": "string"
        },
        "path": {
          "description": "Project root path (uses initialized root if omitted)",
          "type": "string"
        },
        "strict": {
          "default": false,
          "description": "Promote warnings to errors",
          "type": "boolean"
        },
        "test_results": {
          "description": "Path to a specforge-report.json for proof-level verdicts",
          "type": "string"
        },
        "use_cached": {
          "default": false,
          "description": "Use the last compile instead of bringing the project up to date with disk; with no project served, the path is compiled anyway",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "pct": {
                  "type": "number"
                },
                "proven": {
                  "minimum": 0,
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "met"
                  ],
                  "type": "string"
                },
                "total": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "min",
                "pct",
                "proven",
                "total"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "pct": {
                  "type": "number"
                },
                "proven": {
                  "minimum": 0,
                  "type": "integer"
                },
                "status": {
                  "enum": [
                    "below"
                  ],
                  "type": "string"
                },
                "total": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "status",
                "min",
                "pct",
                "proven",
                "total"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "min": {
                  "type": "number"
                },
                "reason": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "unjudged"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "status",
                "min",
                "reason"
              ],
              "type": "object"
            }
          ],
          "type": "object"
        },
        "ok": {
          "type": "boolean"
        },
        "passes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "findings": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "column": {
                      "minimum": 0,
