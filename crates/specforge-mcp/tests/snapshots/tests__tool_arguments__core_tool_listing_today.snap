                  },
                  "id": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "line": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "required": [
