// Generated by specforge model
// Schema version: 1.0.0

// ── @specforge/software ──

TableGroup software {
  behavior
  event
}

Table behavior {
  id varchar [pk]
  contract varchar [not null, note: 'The contract']
  features text [note: 'BehaviorImplementsFeature -> feature']
}

Table event {
  id varchar [pk]
}

// ── @specforge/product ──

TableGroup product {
  feature
  journey
}

Table feature {
  id varchar [pk]
}

Table journey {
  id varchar [pk]
}

// ── Relationships ──

Ref BehaviorImplementsFeature: behavior.features <> feature.id
Ref Triggers: behavior.id <> event.id
Ref JourneyExercisesFeature: journey.id <> feature.id
