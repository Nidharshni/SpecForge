              }
            ],
            "category": "query",
            "description": "The deliverables that declare depends_on the deliverable, sorted by id.",
            "export": "cmd__product_deliverable_dependents",
            "id": "deliverable_dependents",
            "title": "Show deliverables that depend on a given deliverable"
          },
          {
            "args": [
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Return at most this many (default 100, clamped to 1-1000)",
                "name": "limit",
                "required": false
              },
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Skip this many first (default 0)",
                "name": "offset",
                "required": false
              }
            ],
            "category": "query",
            "description": "Per persona, by id, the features its journeys reach and the ones they do not, with the coverage ratio and journey count, paged; the feature total and the mean coverage over every persona.",
            "export": "cmd__product_coverage_matrix",
            "id": "coverage_matrix",
            "title": "Show the persona coverage matrix"
          },
          {
            "args": [
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Return at most this many (default 100, clamped to 1-1000)",
                "name": "limit",
                "required": false
              },
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Skip this many first (default 0)",
                "name": "offset",
                "required": false
              }
            ],
            "category": "query",
            "description": "Per channel, by id, the features the journeys using it reach and the ones they do not, with the coverage ratio and journey count, paged; the feature total and the mean coverage over every channel.",
            "export": "cmd__product_channel_coverage_matrix",
            "id": "channel_coverage_matrix",
            "title": "Show the channel coverage matrix"
          },
          {
            "args": [
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Return at most this many (default 100, clamped to 1-1000)",
                "name": "limit",
                "required": false
              },
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Skip this many first (default 0)",
                "name": "offset",
                "required": false
              }
            ],
            "category": "query",
            "description": "The features two or more deliverables reach through a journey or a module, with those deliverables, most shared first, paged.",
            "export": "cmd__product_feature_overlap",
            "id": "feature_overlap",
            "title": "Show features shared across deliverables"
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The term id",
                "name": "term",
                "required": true
              },
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "How many see_also hops to follow (default 1; above 5 counts as 5)",
                "name": "max_hops",
                "required": false
              }
            ],
            "category": "query",
            "description": "The terms reachable from a term over see_also within --max-hops (default 1, at most 5), sorted by id, the term itself left out.",
            "export": "cmd__product_term_graph",
            "id": "term_graph",
            "title": "Show the terms related to a term"
          },
          {
            "args": [],
            "category": "query",
            "description": "The connected components of the see_also graph between terms (undirected), largest first, ties by first term id; terms with no see_also link are counted as isolated.",
            "export": "cmd__product_term_clusters",
            "id": "term_clusters",
            "title": "Show clusters of related terms"
          },
          {
            "args": [],
            "category": "query",
            "description": "Terms, see_also references between them, average and maximum connections, hub terms (more than twice the average and at least 3) and isolated terms.",
            "export": "cmd__product_term_density",
            "id": "term_density",
            "title": "Show how connected the glossary is"
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The date to compare against, YYYY-MM-DD (default: today, UTC)",
                "name": "as_of",
                "required": false
              }
            ],
            "category": "query",
            "description": "Every milestone by target date, undated ones last, by id within a date; a milestone not completed whose target date is before --as-of (default today) is overdue.",
            "export": "cmd__product_milestone_timeline",
            "id": "milestone_timeline",
            "title": "Show the milestone timeline"
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The milestone id",
                "name": "milestone",
                "required": true
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The date to compare against, YYYY-MM-DD (default: today, UTC)",
                "name": "as_of",
                "required": false
              }
            ],
            "category": "query",
            "description": "A milestone's done, in-progress and remaining features, its completion, the days elapsed since its start date (or target date) as of --as-of (default today), features done per day and the days that pace leaves.",
            "export": "cmd__product_milestone_velocity",
            "id": "milestone_velocity",
            "title": "Show a milestone's velocity"
          },
          {
            "args": [
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The milestone id",
                "name": "milestone",
                "required": true
              }
            ],
            "category": "query",
            "description": "A milestone's completion weighted by effort (xs=1, s=2, m=3, l=5, xl=8; a feature without one weighs as m), with its features per effort level.",
            "export": "cmd__product_weighted_milestone_completion",
            "id": "weighted_milestone_completion",
            "title": "Show a milestone's effort-weighted completion"
          },
          {
            "args": [],
            "category": "query",
            "description": "For each product kind with a lifecycle, how many entities have each status.",
            "export": "cmd__product_bulk_status",
