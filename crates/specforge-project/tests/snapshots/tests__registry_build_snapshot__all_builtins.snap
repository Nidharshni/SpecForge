  "manifest_surfaces": [
    {
      "extension": "@specforge/product",
      "surfaces": {
        "commands": [
          {
            "args": [
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "proposed",
                      "accepted",
                      "in_progress",
                      "done",
                      "deferred",
                      "deprecated"
                    ]
                  }
                },
                "default_value": null,
                "description": "Only features with this status: proposed (also a feature without one), accepted, in_progress, done, deferred or deprecated",
                "name": "status",
                "required": false
              },
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "critical",
                      "high",
                      "medium",
                      "low"
                    ]
                  }
                },
                "default_value": null,
                "description": "Only features with this priority: critical, high, medium, low",
                "name": "priority",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "Only features with at least one of these tags (comma-separated)",
                "name": "tags",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The field to sort by (default id): id, title or a field a feature declares; ties by id",
                "name": "sort_by",
                "required": false
              },
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "asc",
                      "desc"
                    ]
                  }
                },
                "default_value": null,
                "description": "asc (the default) or desc",
                "name": "sort_order",
                "required": false
              },
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Return at most this many (default 100, clamped to 1-1000)",
                "name": "limit",
                "required": false
              },
              {
                "arg_type": "integer",
                "default_value": null,
                "description": "Skip this many first (default 0)",
                "name": "offset",
                "required": false
              }
            ],
            "category": "query",
            "description": "List features: each feature's id, title, status, priority, problem and tags, filtered (every filter set must match), sorted (by id unless --sort-by says otherwise) and paged, with the total before paging.",
            "export": "cmd__product_features",
            "id": "features",
            "title": "List features"
          },
          {
            "args": [
              {
                "arg_type": {
                  "enum": {
                    "values": [
                      "critical",
                      "high",
                      "medium",
                      "low"
                    ]
                  }
                },
                "default_value": null,
                "description": "Only journeys with this priority: critical, high, medium, low",
                "name": "priority",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "Only journeys of this persona (its id)",
                "name": "persona",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "Only journeys with at least one of these tags (comma-separated)",
                "name": "tags",
                "required": false
              },
              {
                "arg_type": "string",
                "default_value": null,
                "description": "The field to sort by (default id): id, title or a field a journey declares; ties by id",
                "name": "sort_by",
                "required": false
              },
              {
