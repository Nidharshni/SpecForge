[
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "category": "core",
    "description": "List features: each feature's id, title, status, priority, problem and tags, filtered (every filter set must match), sorted (by id unless --sort-by says otherwise) and paged, with the total before paging.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "Return at most this many (default 100, clamped to 1-1000)",
          "minimum": 0,
          "type": "integer"
        },
        "offset": {
          "description": "Skip this many first (default 0)",
          "minimum": 0,
          "type": "integer"
        },
        "priority": {
          "description": "Only features with this priority",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "type": "string"
        },
        "sort_by": {
          "description": "The field to sort by (default id): id, title or a field a feature declares; ties by id",
          "type": "string"
        },
        "sort_order": {
          "description": "asc (the default) or desc",
          "enum": [
            "asc",
            "desc"
          ],
          "type": "string"
        },
        "status": {
          "description": "Only features with this status; a feature without one counts as proposed",
          "enum": [
            "proposed",
            "accepted",
            "in_progress",
            "done",
            "deferred",
            "deprecated"
          ],
          "type": "string"
        },
        "tags": {
          "description": "Only features with at least one of these tags (comma-separated)",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "specforge.product.features",
    "source": "@specforge/product"
  },
